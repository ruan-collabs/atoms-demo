APP_ENV=development
DATABASE_URL=postgresql://atoms:atoms@127.0.0.1:5432/atoms
APP_SECRET=development-only-change-before-deploy
PUBLIC_ORIGIN=http://localhost:5173
# file仅用于本地开发，不发送真实邮件；生产只能smtp或disabled
MAIL_MODE=file
MAIL_FROM=Atoms Demo <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MODEL_ALLOWED_ORIGINS=https://api.openai.com,https://api.deepseek.com
SESSION_DAYS=7
# Google OAuth Web application credentials，Secret只放后端环境变量
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 回调自动使用 PUBLIC_ORIGIN/api/auth/google/callback
DEV_MOCK_AUTH=false
DEV_MOCK_MODEL=false
# 仅演示环境：无需自有通配域的Mock沙箱与后台Worker；production拒绝
DEV_MOCK_SANDBOX=false
DEV_INLINE_WORKER=false
# production必须通过独立SecretManager/Railway变量提供32字节密钥的URL-safe base64
CREDENTIAL_MASTER_KEY=
# 本地开发密钥文件不提交，scripts/start-local-db.sh仅负责数据库
# CREDENTIAL_KEY_FILE=.runtime/credential.key
PREVIEW_ORIGIN=http://localhost:8001
APP_ORIGIN=http://localhost:8002
RUN_BUDGET_SECONDS=180
LEASE_SECONDS=60
# Pipecat实时语音转文字；语音服务Key与模型Key独立，仅服务端
VOICE_ENABLED=false
DEEPGRAM_API_KEY=
VOICE_MODEL=nova-2
VOICE_LANGUAGE=zh-CN
VOICE_MAX_SECONDS=60
VOICE_MAX_CONNECTIONS=2
